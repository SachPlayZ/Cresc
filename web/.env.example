# Copy to .env.local and fill in. NEVER commit .env.local. Testnet only.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Arc / Circle (Arc Testnet) ---
# KEYED RPC — put your real keyed URL in .env.local ONLY (the token after /v1/ is a secret).
# Example shape: https://rpc.testnet.arc-node.thecanteenapp.com/v1/swrm_<your-token>
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
# USDC ERC-20 interface on Arc Testnet (6 decimals via the ERC-20 interface; native gas uses 18 — read decimals() always)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# EURC (only if multi-currency is used)
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Gateway (Nanopayments) facilitator API — testnet
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CAIP-2 network id for Arc Testnet (used in x402 requirements)
ARC_CAIP2=eip155:5042002
# SDK chain name string for GatewayClient
ARC_SDK_CHAIN=arcTestnet
# Gateway Wallet contract on Arc Testnet (verifyingContract in EIP-3009 domain) — VERIFIED, domain 26
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# Gateway Minter (withdraw/mint flows)
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B

# EOA wallets ONLY (SCA unsupported by Gateway). Two options (use one or both):
#
# Option A — raw EOA keys (simple, no Circle account needed). Generate via `npm run generate-wallets`.
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# Option B — Circle developer-controlled wallets (managed keys, MPC signing, no raw private key needed).
# Setup: (1) Get API key from console.circle.com, (2) generate+register entity secret, (3) run:
#   npx tsx --env-file=.env.local scripts/setup-circle-wallets.mts
# When CIRCLE_API_KEY + ENTITY_SECRET are set, signPaymentAuthorization uses Circle MPC signing
# instead of raw BUYER_PRIVATE_KEY. SELLER_ADDRESS / BUYER_ADDRESS still needed for Gateway.
# EOA account type only (SCA unsupported by Gateway nanopayments).
CIRCLE_API_KEY=
ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_SELLER_WALLET_ID=
CIRCLE_SELLER_WALLET_ADDRESS=
CIRCLE_BUYER_WALLET_ID=
CIRCLE_BUYER_WALLET_ADDRESS=

# --- LLM (agents). Groq via OpenAI-compatible API. Omit LLM_API_KEY to run agents in deterministic mock mode. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# --- WalletConnect (RainbowKit) ---
# Get a free project ID at https://cloud.walletconnect.com — required for WalletConnect modal.
# MetaMask (injected) works without this; WalletConnect QR scan requires it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Reader wallet encryption (raw EOA path) ---
# 32 random bytes, hex-encoded. Required when CIRCLE_API_KEY is absent (raw EOA key storage).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
READER_KEY_SECRET=

# --- AWS S3 (media uploads: images + videos in the rich editor) ---
# Setup: create bucket, block public access, add CORS (PUT+GET from *), IAM user with s3:PutObject+s3:GetObject.
# Omit these keys to run in mock mode (presign returns a placeholder URL for dev/testing).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=piece-media-cresc
# Optional: CloudFront or custom CDN base URL. Defaults to https://s3.<region>.amazonaws.com/<bucket>
S3_CDN_BASE=

# --- App config ---
# Set to your deployed domain (e.g. https://cresc.vercel.app). Falls back to VERCEL_URL then localhost:3000.
NEXT_PUBLIC_APP_URL=
PRICE_CEILING=0.1
PRICE_FLOOR_MIN=0.001
SWEEP_INTERVAL_MINUTES=15
HEARTBEAT_INTERVAL_SECONDS=5
SESSION_END_TIMEOUT_SECONDS=25

# Faucet (fund testnet wallets): https://faucet.circle.com/  (select Arc Testnet)
# Explorer: https://testnet.arcscan.app
