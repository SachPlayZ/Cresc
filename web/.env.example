# Copy to .env.local and fill in. NEVER commit .env.local. Testnet only.
# Vercel (this app) is stateless and holds no raw keys — see agents/.env.example for
# the EC2 side (BUYER_PRIVATE_KEY, CONTENT_TUNER_PRIVATE_KEY).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Arc (Arc Testnet) ---
# KEYED RPC — put your real keyed URL in .env.local ONLY (the token after /v1/ is a secret).
# Example shape: https://rpc.testnet.arc-node.thecanteenapp.com/v1/swrm_<your-token>
# Server-side only — never NEXT_PUBLIC_.
ARC_RPC_URL=

# --- Contract-native content (ContentFactory / ContentVault, see contracts/) ---
# Address of the deployed ContentFactory (see contracts/DEPLOY.md). Used to build
# chainConfig; the actual per-content vault address is read from the articles table.
CONTENT_FACTORY_ADDRESS=

# --- Circle user-controlled wallets (UCW) — creator wallet system ---
# Backend API key (console.circle.com). Frontend uses the NEXT_PUBLIC_ app/client IDs
# to initialize the W3S SDK directly — no server round-trip needed for those.
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_GOOGLE_CLIENT_ID=

# --- Internal Vercel<->EC2 HMAC auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the value in agents/.env.local exactly.
INTERNAL_HMAC_SECRET=
EC2_AGENT_BASE_URL=

# --- Ghost admin key encryption at rest (AES-256-GCM, 32-byte hex) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GHOST_KEY_ENCRYPTION_SECRET=

# --- App config ---
# Set to your deployed domain (e.g. https://cresc.vercel.app). Falls back to VERCEL_URL then localhost:3000.
NEXT_PUBLIC_APP_URL=

# Faucet (fund testnet wallets): https://faucet.circle.com/  (select Arc Testnet)
# Explorer: https://testnet.arcscan.app
