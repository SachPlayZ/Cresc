# Copy to .env.local and fill in. NEVER commit .env.local. Testnet only.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Arc / Circle (Arc Testnet) ---
# KEYED RPC — put your real keyed URL in .env.local ONLY (the token after /v1/ is a secret).
# Example shape: https://rpc.testnet.arc-node.thecanteenapp.com/v1/swrm_<your-token>
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
# USDC ERC-20 interface on Arc Testnet (6 decimals via the ERC-20 interface; native gas uses 18 — read decimals() always)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# EURC (only if multi-currency is used)
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Gateway (Nanopayments) facilitator API — testnet
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# CAIP-2 network id for Arc Testnet (used in x402 requirements)
ARC_CAIP2=eip155:5042002
# SDK chain name string for GatewayClient
ARC_SDK_CHAIN=arcTestnet
# Gateway Wallet contract on Arc Testnet (verifyingContract in EIP-3009 domain) — VERIFIED, domain 26
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# Gateway Minter (withdraw/mint flows)
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B

# EOA wallets ONLY (SCA unsupported by Gateway). Generated by `npm run generate-wallets`. Server-side only.
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# --- LLM (agents). Groq via OpenAI-compatible API. Omit LLM_API_KEY to run agents in deterministic mock mode. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# --- App config ---
PRICE_CEILING=0.1
PRICE_FLOOR_MIN=0.001
SWEEP_INTERVAL_MINUTES=15
HEARTBEAT_INTERVAL_SECONDS=5
SESSION_END_TIMEOUT_SECONDS=25

# Faucet (fund testnet wallets): https://faucet.circle.com/  (select Arc Testnet)
# Explorer: https://testnet.arcscan.app
