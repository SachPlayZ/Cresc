# Copy to .env.local and fill in. NEVER commit .env.local. Testnet only.
# EC2 holds the one raw buyer key + the content-tuner relayer key. Never copy these into web/.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Arc RPC (secret — server-side only) ---
# KEYED RPC — put your real keyed URL in .env.local ONLY (the token after /v1/ is a secret).
# Example shape: https://rpc.testnet.arc-node.thecanteenapp.com/v1/swrm_<your-token>
ARC_RPC_URL=

# --- Buyer (x402 nanopayment signer) — raw EOA key, EC2-only. Generate via `npm run generate-wallets`. ---
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# SELLER_PRIVATE_KEY must NEVER be set here — startup assertion throws if present.
# Creator payouts are ContentVault withdrawals (direct by the creator, or relayed via
# CONTENT_TUNER_PRIVATE_KEY against a creator-signed EIP-712 authorization), never an
# app-held raw creator key.

# --- Contract-native content (ContentFactory / ContentVault, see contracts/) ---
# Address of the deployed ContentFactory (see contracts/DEPLOY.md).
CONTENT_FACTORY_ADDRESS=
# Relayer key: creates content, tunes prices, and relays creator-signed withdrawals.
# Generate via `npm run generate-wallets`.
CONTENT_TUNER_PRIVATE_KEY=
# Optional — only used as a fallback address when CONTENT_TUNER_PRIVATE_KEY is absent.
CONTENT_TUNER_ADDRESS=

# --- Groq (agents). Omit GROQ_API_KEY to run gates/audit in deterministic mock mode. ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Pinata (IPFS pinning for price-tune reasoning). Omit to skip pinning (reason_cid
# stays null) — get a JWT from https://app.pinata.cloud/developers/api-keys. ---
PINATA_JWT=

# --- Internal Vercel<->EC2 HMAC auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the value in web/.env.local exactly.
INTERNAL_HMAC_SECRET=

# Base URL of the Vercel app (EC2 needs this to construct the tip x402 endpoint URL).
APP_BASE_URL=

# --- HTTP server ---
PORT=4000

# --- Reader Agent gate thresholds ---
QUALITY_MIN=0.5
INTEREST_MIN=0.5
CONFIDENCE_MIN=80

# --- Watcher (pricing) tuning ---
# PRICE_MAX_ATOMIC must never exceed ContentVault.PRICE_MAX_ATOMIC (1_000_000 / $1.00) —
# the contract ceiling always wins regardless of this value.
PRICE_MIN_ATOMIC=10000
PRICE_MAX_ATOMIC=1000000
W_VIEWS=0.4
W_DWELL=0.4
W_TIPS=0.2
WATCHER_INTERVAL_MINUTES=60
AUDIT_INTERVAL_MINUTES=55

# Faucet (fund testnet wallets): https://faucet.circle.com/  (select Arc Testnet)
# Explorer: https://testnet.arcscan.app
